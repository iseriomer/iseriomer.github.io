:root {
    --primary: #a78bfa;
    --primary-glow: #8b5cf6;
    --accent: #f472b6;
    --accent-glow: #ec4899;
    --cyan: #22d3ee;
    --success: #34d399;
    --warning: #fbbf24;
    --text-primary: #f9fafb;
    --text-secondary: #d1d5db;
    --text-muted: #9ca3af;
    --bg-dark: #0a0118;
    --bg-darker: #050008;
    --card-bg: rgba(30, 41, 59, 0.6);
    --card-border: rgba(167, 139, 250, 0.2);
    --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    --font-main: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-heading: 'Poppins', var(--font-main);
}

* { 
    margin: 0; 
    padding: 0; 
    box-sizing: border-box; 
}

html { 
    scroll-behavior: smooth; 
}

body {
    font-family: var(--font-main);
    background: var(--bg-dark);
    color: var(--text-primary);
    line-height: 1.7;
    overflow-x: hidden;
    position: relative;
}

/* Animated Background */
.bg-animation {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: radial-gradient(ellipse at top, rgba(139, 92, 246, 0.15), transparent 50%),
                radial-gradient(ellipse at bottom, rgba(236, 72, 153, 0.1), transparent 50%);
}

.bg-grid {
    position: absolute;
    inset: 0;
    background-image: 
        linear-gradient(rgba(167, 139, 250, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(167, 139, 250, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridMove 20s linear infinite;
}

@keyframes gridMove {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
}

.floating-particles {
    position: absolute;
    inset: 0;
}

.particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: var(--primary);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--primary-glow);
    animation: float-particle 15s infinite ease-in-out;
}

.particle:nth-child(1) { left: 10%; top: 20%; animation-delay: 0s; }
.particle:nth-child(2) { left: 80%; top: 40%; animation-delay: 2s; }
.particle:nth-child(3) { left: 30%; top: 70%; animation-delay: 4s; }
.particle:nth-child(4) { left: 60%; top: 10%; animation-delay: 1s; }
.particle:nth-child(5) { left: 90%; top: 80%; animation-delay: 3s; }

@keyframes float-particle {
    0%, 100% { transform: translate(0, 0); opacity: 0.3; }
    50% { transform: translate(30px, -30px); opacity: 0.8; }
}

.container { 
    max-width: 1400px; 
    margin: 0 auto; 
    padding: 0 32px;
    position: relative;
    z-index: 1;
}

/* Glassmorphism Navigation */
nav {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(0);
    width: calc(100% - 40px);
    max-width: 1400px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 16px 32px;
    z-index: 1000;
    transition: all 0.3s ease;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    opacity: 1;
}

nav.scrolled {
    top: 10px;
    padding: 10px 24px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 32px rgba(139, 92, 246, 0.2);
    border-color: rgba(167, 139, 250, 0.3);
}

nav.scrolled .logo {
    font-size: 1.5rem;
}

nav.scrolled .nav-links {
    gap: 32px;
}

nav.scrolled .nav-links a {
    font-size: 0.85rem;
    padding: 6px 12px;
}

nav .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0;
}

.logo {
    font-size: 1.8rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
    font-family: var(--font-heading);
    letter-spacing: 1px;
    position: relative;
}

.logo::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    transform: scaleX(0);
    transition: transform 0.3s;
}

.logo:hover::after { 
    transform: scaleX(1); 
}

.nav-links {
    display: flex;
    gap: 40px;
    list-style: none;
    align-items: center;
}

.nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: var(--transition);
    position: relative;
    letter-spacing: 0.5px;
    padding: 8px 16px;
    border-radius: 10px;
}

.nav-links a::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(167, 139, 250, 0.1);
    border-radius: 10px;
    opacity: 0;
    transition: opacity 0.3s;
}

.nav-links a:hover {
    color: var(--text-primary);
}

.nav-links a:hover::before {
    opacity: 1;
}

.hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    cursor: pointer;
    padding: 12px;
    width: 48px;
    height: 48px;
    position: relative;
    z-index: 1001;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.hamburger:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: var(--primary);
    transform: scale(1.05);
    box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3);
}

.hamburger span {
    display: block;
    width: 24px;
    height: 2.5px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: 3px;
    transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    transform-origin: center;
    position: relative;
}

.hamburger.active span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
}

.hamburger.active span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
}

.hamburger.active span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
}

/* Hero Section */
header {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 120px 0 80px;
}

.hero-glow {
    position: absolute;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.3), transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: pulse-glow 4s ease-in-out infinite;
    pointer-events: none;
}

@keyframes pulse-glow {
    0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 0.8; transform: translate(-50%, -50%) scale(1.1); }
}

.hero-content {
    position: relative;
    z-index: 10;
    max-width: 900px;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(167, 139, 250, 0.1);
    backdrop-filter: blur(10px);
    padding: 12px 24px;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 32px;
    border: 1px solid var(--card-border);
    box-shadow: 0 0 30px rgba(139, 92, 246, 0.3);
}

h1 {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    line-height: 1;
    margin-bottom: 32px;
    background: linear-gradient(135deg, #fff 0%, var(--primary) 50%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -2px;
    animation: gradient-shift 3s ease infinite;
    background-size: 200% 200%;
}

@keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
}

.hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    margin-bottom: 48px;
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 700px;
}

.cta-group {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 40px;
    border-radius: 16px;
    font-weight: 700;
    text-decoration: none;
    transition: var(--transition);
    font-size: 1rem;
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    letter-spacing: 0.5px;
}

.btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: translateX(-100%);
    transition: transform 0.6s;
}

.btn:hover::before {
    transform: translateX(100%);
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary-glow), var(--accent-glow));
    color: white;
    box-shadow: 0 10px 40px rgba(139, 92, 246, 0.4);
}

.btn-primary:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 20px 60px rgba(139, 92, 246, 0.6);
}

.btn-secondary {
    background: rgba(167, 139, 250, 0.1);
    backdrop-filter: blur(10px);
    color: white;
    border: 2px solid var(--card-border);
}

.btn-secondary:hover {
    background: rgba(167, 139, 250, 0.2);
    border-color: var(--primary);
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(167, 139, 250, 0.3);
}

/* Sections */
section {
    padding: 120px 0;
    position: relative;
}

.section-header {
    text-align: center;
    margin-bottom: 80px;
    position: relative;
}

.section-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(236, 72, 153, 0.2));
    color: var(--primary);
    padding: 10px 24px;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 24px;
    border: 1px solid var(--card-border);
    box-shadow: 0 0 30px rgba(139, 92, 246, 0.2);
}

h2 {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    background: linear-gradient(135deg, #fff, var(--primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 24px;
    letter-spacing: -1px;
}

.section-description {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.8;
}

/* Game Cards - Kompakt Grid */
.games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 80px;
}

.game-card {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--card-border);
    transition: var(--transition);
    position: relative;
    cursor: pointer;
}

.game-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(167, 139, 250, 0.1), rgba(236, 72, 153, 0.1));
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
    z-index: 1;
}

.game-card:hover::before {
    opacity: 1;
}

.game-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(139, 92, 246, 0.4);
    border-color: var(--primary);
}

.game-image-wrapper {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(236, 72, 153, 0.2));
}

.game-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.game-card:hover .game-image {
    transform: scale(1.1);
}

.game-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.7) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s;
    z-index: 2;
}

.game-overlay span {
    color: white;
    font-weight: 700;
    font-size: 1rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
}

.game-card:hover .game-overlay {
    opacity: 1;
}

.game-content {
    padding: 20px;
    position: relative;
    z-index: 1;
}

.game-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 12px;
}

.game-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 6px;
    font-family: var(--font-heading);
    letter-spacing: -0.5px;
    line-height: 1.2;
}

.award-badge {
    background: linear-gradient(135deg, var(--warning), #f59e0b);
    color: var(--bg-dark);
    padding: 6px 12px;
    border-radius: 10px;
    font-size: 0.7rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(251, 191, 36, 0.4);
    flex-shrink: 0;
}

.game-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.4;
}

.game-card-buttons {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    flex-wrap: wrap;
}

.game-card-btn {
    flex: 1;
    min-width: 100px;
    padding: 10px 16px;
    font-size: 0.85rem;
    justify-content: center;
}

/* Modal Styles */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(10px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.modal-overlay.active {
    display: flex;
    opacity: 1;
}

.modal-content {
    background: var(--card-bg);
    backdrop-filter: blur(30px);
    border-radius: 24px;
    border: 1px solid var(--card-border);
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    transform: scale(0.9);
    transition: transform 0.3s ease;
    scrollbar-width: none;
    -ms-overflow-style: none;
}

.modal-overlay.active .modal-content {
    transform: scale(1);
}

.modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: var(--text-primary);
    font-size: 1.8rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    z-index: 10;
    line-height: 1;
    padding: 0;
}

.modal-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg);
    border-color: var(--primary);
}

.modal-image-wrapper {
    position: relative;
    width: 100%;
    height: 300px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(236, 72, 153, 0.2));
    cursor: pointer;
}

.modal-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
}

.gallery-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(10px);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    color: white;
    font-size: 2rem;
    font-weight: bold;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    z-index: 5;
    opacity: 0;
}

.modal-image-wrapper:hover .gallery-nav {
    opacity: 1;
}

.gallery-prev {
    left: 20px;
}

.gallery-next {
    right: 20px;
}

.gallery-nav:hover {
    background: rgba(0, 0, 0, 0.8);
    border-color: var(--primary);
    transform: translateY(-50%) scale(1.1);
}

.gallery-indicator {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(10px);
    padding: 8px 16px;
    border-radius: 20px;
    color: white;
    font-size: 0.85rem;
    font-weight: 600;
    z-index: 5;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.modal-body {
    padding: 32px;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 24px;
    gap: 16px;
}

.modal-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 8px;
    font-family: var(--font-heading);
    letter-spacing: -0.5px;
}

.modal-meta {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.modal-award-badge {
    background: linear-gradient(135deg, var(--warning), #f59e0b);
    color: var(--bg-dark);
    padding: 8px 16px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 800;
    display: none;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(251, 191, 36, 0.4);
}

.modal-description {
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 28px;
    font-size: 1.1rem;
}

.modal-features {
    list-style: none;
    margin-bottom: 28px;
}

.modal-features li {
    padding: 12px 0 12px 32px;
    position: relative;
    color: var(--text-secondary);
    font-size: 1rem;
    border-bottom: 1px solid rgba(167, 139, 250, 0.1);
}

.modal-features li:last-child {
    border-bottom: none;
}

.modal-features li::before {
    content: '◆';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 1.2rem;
    animation: pulse 2s ease-in-out infinite;
}

.modal-tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
}

.modal-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.modal-links .btn {
    flex: 1;
    min-width: 160px;
    justify-content: center;
    padding: 14px 24px;
    font-size: 0.95rem;
}

/* Tech tag styles (used in modal) */
.tech-tag {
    background: rgba(167, 139, 250, 0.15);
    color: var(--primary);
    padding: 8px 16px;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    border: 1px solid rgba(167, 139, 250, 0.3);
    transition: var(--transition);
    letter-spacing: 0.5px;
}

.tech-tag:hover {
    background: rgba(167, 139, 250, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(167, 139, 250, 0.4);
}

@keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
}

/* Skills Section */
.skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 32px;
    margin-top: 80px;
}

.skill-card {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    padding: 40px;
    border-radius: 24px;
    border: 1px solid var(--card-border);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.skill-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--primary), var(--accent), var(--cyan));
    transform: scaleX(0);
    transition: transform 0.4s;
}

.skill-card:hover::before {
    transform: scaleX(1);
}

.skill-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(139, 92, 246, 0.3);
    border-color: var(--primary);
}

.skill-icon {
    font-size: 3rem;
    margin-bottom: 24px;
    filter: drop-shadow(0 0 20px rgba(167, 139, 250, 0.6));
}

.skill-card h3 {
    font-size: 1.5rem;
    margin-bottom: 24px;
    color: var(--text-primary);
    font-weight: 800;
    font-family: var(--font-heading);
}

.skill-list {
    list-style: none;
}

.skill-list li {
    padding: 14px 0;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(167, 139, 250, 0.1);
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 500;
}

.skill-list li::before {
    content: '▸';
    color: var(--accent);
    font-size: 1.2rem;
}

.skill-list li:last-child {
    border-bottom: none;
}

/* About Section */
#about {
    background: radial-gradient(ellipse at center, rgba(139, 92, 246, 0.05), transparent 70%);
}

.about-content {
    max-width: 1000px;
    margin: 0 auto;
}

.about-text {
    font-size: 1.2rem;
    line-height: 2;
    color: var(--text-secondary);
    margin-bottom: 32px;
    text-align: justify;
}

.about-text strong {
    color: var(--primary);
    font-weight: 700;
}

.quick-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 48px;
    justify-content: center;
}

/* Contact Section */
.contact-content {
    max-width: 700px;
    margin: 0 auto;
}

.contact-form {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    padding: 48px;
    border-radius: 24px;
    border: 1px solid var(--card-border);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.form-group {
    margin-bottom: 28px;
}

label {
    display: block;
    margin-bottom: 12px;
    font-weight: 700;
    color: var(--text-primary);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

input, textarea {
    width: 100%;
    padding: 16px;
    border: 2px solid rgba(167, 139, 250, 0.2);
    border-radius: 12px;
    font-family: var(--font-main);
    font-size: 1rem;
    background: rgba(10, 1, 24, 0.5);
    color: var(--text-primary);
    transition: var(--transition);
}

input:focus, textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.2);
    background: rgba(10, 1, 24, 0.8);
}

textarea {
    resize: vertical;
    min-height: 180px;
}

.submit-btn {
    width: 100%;
    padding: 20px;
    background: linear-gradient(135deg, var(--primary-glow), var(--accent-glow));
    color: white;
    border: none;
    border-radius: 12px;
    font-weight: 800;
    font-size: 1.1rem;
    cursor: pointer;
    transition: var(--transition);
    text-transform: uppercase;
    letter-spacing: 2px;
    box-shadow: 0 10px 40px rgba(139, 92, 246, 0.4);
}

.submit-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(139, 92, 246, 0.6);
}

/* Footer */
footer {
    background: var(--bg-darker);
    color: white;
    padding: 80px 0 40px;
    text-align: center;
    border-top: 1px solid var(--card-border);
    position: relative;
}

.social-links {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-bottom: 32px;
}

.social-link {
    width: 60px;
    height: 60px;
    background: rgba(167, 139, 250, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    text-decoration: none;
    color: white;
    font-size: 1.5rem;
    border: 1px solid var(--card-border);
}

.social-link:hover {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    transform: translateY(-8px) rotate(5deg);
    box-shadow: 0 10px 40px rgba(139, 92, 246, 0.6);
}

/* Scroll to Top */
.scroll-top {
    position: fixed;
    bottom: 40px;
    right: 40px;
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.8rem;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition);
    z-index: 999;
    box-shadow: 0 10px 40px rgba(139, 92, 246, 0.6);
    border: 2px solid rgba(255, 255, 255, 0.2);
}

.scroll-top.visible {
    opacity: 1;
    visibility: visible;
}

.scroll-top:hover {
    transform: translateY(-8px) scale(1.1);
    box-shadow: 0 15px 50px rgba(139, 92, 246, 0.8);
}

/* Toast Notification */
.toast {
    position: fixed;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%) translateY(150px);
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    color: var(--text-primary);
    padding: 20px 32px;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    opacity: 0;
    visibility: hidden;
    transition: var(--transition);
    z-index: 1100;
    border: 1px solid var(--card-border);
}

.toast.show {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
}

.fade-in {
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.glow-text {
    text-shadow: 0 0 20px rgba(167, 139, 250, 0.8);
}

/* Responsive */
@media (max-width: 968px) {
    nav {
        top: 10px;
        left: 20px;
        right: 20px;
        transform: none;
        width: auto;
    }

    .hamburger { 
        display: flex; 
    }
    
    .nav-links {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(10, 1, 24, 0.98);
        backdrop-filter: blur(30px) saturate(180%);
        -webkit-backdrop-filter: blur(30px) saturate(180%);
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 100px 32px 32px;
        gap: 8px;
        transform: translateX(100%);
        opacity: 0;
        visibility: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1000;
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .nav-links::-webkit-scrollbar {
        display: none;
    }

    .nav-links.active {
        transform: translateX(0);
        opacity: 1;
        visibility: visible;
        padding-top: 200px;
        padding-bottom: 200px;
        border-top-width: 200px;
        margin-top: 84px;
    }

    .nav-links li {
        width: 100%;
        max-width: 500px;
        opacity: 0;
        transform: translateY(20px);
    }

    .nav-links.active li {
        animation: slideInFade 0.5s ease-out forwards;
    }

    .nav-links.active li:nth-child(1) {
        animation-delay: 0.1s;
    }

    .nav-links.active li:nth-child(2) {
        animation-delay: 0.15s;
    }

    .nav-links.active li:nth-child(3) {
        animation-delay: 0.2s;
    }

    .nav-links.active li:nth-child(4) {
        animation-delay: 0.25s;
    }

    @keyframes slideInFade {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .nav-links a {
        display: block;
        width: 100%;
        padding: 20px 24px;
        font-size: 1.3rem;
        font-weight: 700;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .nav-links a::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(236, 72, 153, 0.2));
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .nav-links a:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--primary);
        transform: translateX(8px) scale(1.02);
        box-shadow: 0 8px 30px rgba(139, 92, 246, 0.4);
        color: var(--text-primary);
    }

    .nav-links a:hover::before {
        opacity: 1;
    }

    body.menu-open {
        overflow: hidden;
    }

    .games-grid {
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
    }

    .modal-content {
        max-width: 95%;
        max-height: 95vh;
    }

    .modal-body {
        padding: 24px;
    }

    .gallery-nav {
        opacity: 1;
        width: 40px;
        height: 40px;
        font-size: 1.5rem;
    }

    .gallery-prev {
        left: 10px;
    }

    .gallery-next {
        right: 10px;
    }

    .game-card-buttons {
        flex-direction: column;
    }

    .game-card-btn {
        width: 100%;
    }

    .skills-grid {
        grid-template-columns: 1fr;
    }


    .cta-group {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }

    .contact-form {
        padding: 32px 24px;
    }

    h1 {
        font-size: 3rem;
    }
}

@media (max-width: 480px) {
    .game-links {
        flex-direction: column;
    }

    .game-btn {
        width: 100%;
    }

}

/* deneme */